# Postgres connection string (Neon / Vercel Postgres). Required.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Local server port (ignored on Vercel).
PORT=8080
# HMAC signing key for JWTs — set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Allowed browser origin for CORS (the frontend URL). Use * only for testing.
CORS_ORIGIN=http://localhost:5173
# Logging: json|text and debug|info|warn|error
LOG_FORMAT=json
LOG_LEVEL=info
